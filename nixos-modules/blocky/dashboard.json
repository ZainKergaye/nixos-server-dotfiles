{
  "uid": "blocky-overview",
  "title": "Blocky DNS",
  "tags": ["blocky", "dns", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "DNS queries per second",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(blocky_response_count[5m]))", "legendFormat": "responses", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "DNS response duration",
      "type": "timeseries",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(blocky_query_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    }
  ]
}
