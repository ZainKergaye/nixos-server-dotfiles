{
  "uid": "router-overview",
  "title": "Router Overview",
  "tags": ["router", "network", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "WAN traffic",
      "description": "Internet ingress (download) and egress (upload) on @WAN_INTERFACE@.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{host=\"main\",device=\"@WAN_INTERFACE@\"}[$__rate_interval])", "legendFormat": "download", "refId": "A" },
        { "expr": "rate(node_network_transmit_bytes_total{host=\"main\",device=\"@WAN_INTERFACE@\"}[$__rate_interval])", "legendFormat": "upload", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "LAN traffic",
      "description": "Traffic between the router and the server LAN on @LAN_INTERFACE@.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{host=\"main\",device=\"@LAN_INTERFACE@\"}[$__rate_interval])", "legendFormat": "from LAN", "refId": "A" },
        { "expr": "rate(node_network_transmit_bytes_total{host=\"main\",device=\"@LAN_INTERFACE@\"}[$__rate_interval])", "legendFormat": "to LAN", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "WAN and LAN errors / drops",
      "description": "Any sustained non-zero rate warrants investigation: physical link, NIC driver, queue pressure, or upstream issue.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(node_network_receive_errs_total{host=\"main\",device=~\"@WAN_INTERFACE@|@LAN_INTERFACE@\"}[$__rate_interval])", "legendFormat": "{{device}} RX errors", "refId": "A" },
        { "expr": "rate(node_network_transmit_errs_total{host=\"main\",device=~\"@WAN_INTERFACE@|@LAN_INTERFACE@\"}[$__rate_interval])", "legendFormat": "{{device}} TX errors", "refId": "B" },
        { "expr": "rate(node_network_receive_drop_total{host=\"main\",device=~\"@WAN_INTERFACE@|@LAN_INTERFACE@\"}[$__rate_interval])", "legendFormat": "{{device}} RX drops", "refId": "C" },
        { "expr": "rate(node_network_transmit_drop_total{host=\"main\",device=~\"@WAN_INTERFACE@|@LAN_INTERFACE@\"}[$__rate_interval])", "legendFormat": "{{device}} TX drops", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 3, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Conntrack table use",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "100 * node_nf_conntrack_entries{host=\"main\"} / node_nf_conntrack_entries_limit{host=\"main\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }] } }, "overrides": [] },
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 8 }
    },
    {
      "id": 5,
      "title": "Router uptime",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "time() - node_boot_time_seconds{host=\"main\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "wideLayout": true },
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 8 }
    },
    {
      "id": 6,
      "title": "Prometheus scrape health",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "up{job=\"nodes\",host=\"main\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "down", "color": "red" }, "1": { "text": "up", "color": "green" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "wideLayout": true },
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 8 }
    },
    {
      "id": 7,
      "title": "Core router services",
      "description": "DNS/DHCP, reverse proxy, VPN, IDS, monitoring, and the Grafana UI.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "node_systemd_unit_state{host=\"main\",name=~\"(blocky|dnsmasq|caddy|wireguard-wg0|suricata|prometheus|grafana)\\\\.service\",state=\"active\"}", "legendFormat": "{{name}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "inactive", "color": "red" }, "1": { "text": "active", "color": "green" } } }] }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "name", "wideLayout": false },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    },
    {
      "id": 8,
      "title": "CPU busy and load",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{host=\"main\",mode=\"idle\"}[$__rate_interval]))))", "legendFormat": "CPU busy", "refId": "A" },
        { "expr": "node_load1{host=\"main\"}", "legendFormat": "load 1m", "refId": "B" },
        { "expr": "node_load5{host=\"main\"}", "legendFormat": "load 5m", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [{ "matcher": { "id": "byName", "options": "CPU busy" }, "properties": [{ "id": "unit", "value": "percent" }] }] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
    },
    {
      "id": 9,
      "title": "Memory and root filesystem available",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "100 * node_memory_MemAvailable_bytes{host=\"main\"} / node_memory_MemTotal_bytes{host=\"main\"}", "legendFormat": "memory available", "refId": "A" },
        { "expr": "100 * node_filesystem_avail_bytes{host=\"main\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{host=\"main\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}", "legendFormat": "root available", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 }
    },
    {
      "id": 10,
      "title": "TCP connections and retransmissions",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "node_netstat_Tcp_CurrEstab{host=\"main\"}", "legendFormat": "established", "refId": "A" },
        { "expr": "rate(node_netstat_Tcp_RetransSegs{host=\"main\"}[$__rate_interval])", "legendFormat": "retransmissions/s", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 }
    },
    {
      "id": 11,
      "title": "DNS query rate and blocking",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(rate(blocky_query_total{host=\"main\"}[$__rate_interval]))", "legendFormat": "queries/s", "refId": "A" },
        { "expr": "sum(rate(blocky_response_total{host=\"main\",response_type=~\"BLOCKED|REBIND\"}[$__rate_interval]))", "legendFormat": "blocked/s", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 }
    },
    {
      "id": 12,
      "title": "IDS alerts and capture drops",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(suricata_eve_alerts_total{host=\"main\"}[$__rate_interval])", "legendFormat": "alerts/s", "refId": "A" },
        { "expr": "rate(suricata_eve_capture_drops_total{host=\"main\"}[$__rate_interval])", "legendFormat": "capture drops/s", "refId": "B" },
        { "expr": "rate(suricata_eve_tcp_reassembly_gaps_total{host=\"main\"}[$__rate_interval])", "legendFormat": "TCP reassembly gaps/s", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 3, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 }
    },
    {
      "id": 13,
      "title": "WAN reachability",
      "description": "Independent ICMP probes from the router. Both targets failing indicates an upstream/WAN problem.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "probe_success{job=\"router-wan-icmp\"}", "legendFormat": "{{instance}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "down", "color": "red" }, "1": { "text": "reachable", "color": "green" } } }] }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "name", "wideLayout": false },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 }
    },
    {
      "id": 14,
      "title": "WAN probe latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "probe_duration_seconds{job=\"router-wan-icmp\"}", "legendFormat": "{{instance}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 }
    },
    {
      "id": 15,
      "title": "DHCP leases and refused connections",
      "description": "Refusals count only new TCP connections rejected in the last two minutes.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "router_dhcp_leases{state=\"active\",host=\"main\"}", "legendFormat": "active DHCP leases", "refId": "A" },
        { "expr": "router_dhcp_leases{state=\"total\",host=\"main\"}", "legendFormat": "known leases", "refId": "B" },
        { "expr": "router_firewall_refused_connections_recent{host=\"main\"}", "legendFormat": "refused connections (2m)", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "decimals": 0, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 }
    },
    {
      "id": 16,
      "title": "Router temperatures",
      "description": "Shown when the hardware exposes thermal or hwmon sensors.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "node_hwmon_temp_celsius{host=\"main\"}", "legendFormat": "{{chip}} {{sensor}}", "refId": "A" },
        { "expr": "node_thermal_zone_temp{host=\"main\"} / 1000", "legendFormat": "{{type}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "celsius", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 }
    },
    {
      "id": 17,
      "title": "WireGuard peer health",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "wireguard_latest_handshake_delay_seconds{interface=\"wg0\"}", "legendFormat": "handshake {{allowed_ips}}", "refId": "A" },
        { "expr": "rate(wireguard_received_bytes_total{interface=\"wg0\"}[$__rate_interval])", "legendFormat": "RX {{allowed_ips}}", "refId": "B" },
        { "expr": "rate(wireguard_sent_bytes_total{interface=\"wg0\"}[$__rate_interval])", "legendFormat": "TX {{allowed_ips}}", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [{ "matcher": { "id": "byRegexp", "options": "^(RX|TX)" }, "properties": [{ "id": "unit", "value": "Bps" }] }, { "matcher": { "id": "byRegexp", "options": "^handshake" }, "properties": [{ "id": "unit", "value": "s" }] }] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 }
    }
  ]
}
