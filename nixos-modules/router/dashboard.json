{
  "uid": "router-overview",
  "title": "Router Overview",
  "tags": ["router", "network", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "LAN / WAN traffic",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{host=\"main\",device!~\"lo\"}[5m])", "legendFormat": "{{device}} receive", "refId": "A" },
        { "expr": "rate(node_network_transmit_bytes_total{host=\"main\",device!~\"lo\"}[5m])", "legendFormat": "{{device}} transmit", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Interface errors and drops",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(node_network_receive_errs_total{host=\"main\",device!~\"lo\"}[5m]) + rate(node_network_receive_drop_total{host=\"main\",device!~\"lo\"}[5m])", "legendFormat": "{{device}} receive", "refId": "A" },
        { "expr": "rate(node_network_transmit_errs_total{host=\"main\",device!~\"lo\"}[5m]) + rate(node_network_transmit_drop_total{host=\"main\",device!~\"lo\"}[5m])", "legendFormat": "{{device}} transmit", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Conntrack table use",
      "type": "gauge",
      "targets": [{ "expr": "100 * node_nf_conntrack_entries{host=\"main\"} / node_nf_conntrack_entries_limit{host=\"main\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }] } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Router uptime",
      "type": "stat",
      "targets": [{ "expr": "node_time_seconds{host=\"main\"} - node_boot_time_seconds{host=\"main\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 }
    },
    {
      "id": 5,
      "title": "Core router services",
      "type": "stat",
      "targets": [{ "expr": "node_systemd_unit_state{host=\"main\",name=~\"(blocky|dnsmasq|caddy|suricata|wireguard-wg0)\\.service\",state=\"active\"}", "legendFormat": "{{name}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "options": { "0": { "text": "inactive", "color": "red" }, "1": { "text": "active", "color": "green" } }, "type": "value" }] }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "id": 6,
      "title": "Suricata stats freshness",
      "type": "gauge",
      "targets": [{ "expr": "time() - max(suricata_eve_stats_last_update_seconds{host=\"main\"})", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "max": 180, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 90 }, { "color": "red", "value": 180 }] } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 16 }
    },
    {
      "id": 7,
      "title": "Suricata alerts",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(suricata_eve_alerts_total{host=\"main\"}[5m])", "legendFormat": "alerts", "refId": "A" },
        { "expr": "rate(suricata_eve_alert_queue_overflow_total{host=\"main\"}[5m])", "legendFormat": "queue overflow", "refId": "B" },
        { "expr": "rate(suricata_eve_alerts_suppressed_total{host=\"main\"}[5m])", "legendFormat": "suppressed", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 4, "y": 16 }
    },
    {
      "id": 8,
      "title": "Suricata capture and engine health",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(suricata_eve_capture_packets_total{host=\"main\"}[5m])", "legendFormat": "packets", "refId": "A" },
        { "expr": "rate(suricata_eve_capture_drops_total{host=\"main\"}[5m])", "legendFormat": "capture drops", "refId": "B" },
        { "expr": "rate(suricata_eve_tcp_reassembly_gaps_total{host=\"main\"}[5m])", "legendFormat": "TCP reassembly gaps", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 }
    },
    {
      "id": 9,
      "title": "Suricata engine uptime",
      "type": "stat",
      "targets": [{ "expr": "suricata_eve_uptime_seconds{host=\"main\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 24 }
    }
  ]
}
